# ==============================================================================
# DERMAIRE PERSONAL SKIN LAB BACKEND — MICROSOFT IMAGINE CUP 2027
# Azure Services Configuration & Secrets Template
# ==============================================================================

# Application Setup
PROJECT_NAME="Dermaire Skin Lab API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Security (Generate a 64-char random hex in production)
SECRET_KEY="dermaire-super-secret-azure-imagine-cup-key-2027-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
# Local SQLite default:
DATABASE_URL="sqlite:///./dermaire_dev.db"
# Azure Database for PostgreSQL (Production):
# DATABASE_URL="postgresql://dermaire_admin:<password>@dermaire-db.postgres.database.azure.com:5432/dermaire_prod?sslmode=require"

# 1. Microsoft Azure Blob Storage (Skin check-in photos & reports)
# Format: "DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net"
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER="skin-records"
AZURE_BLOB_SAS_EXPIRY_MINUTES=30

# 2. Microsoft Azure AI Vision (Image Analysis 4.0)
AZURE_VISION_ENDPOINT=""
AZURE_VISION_KEY=""

# 3. Microsoft Azure OpenAI Service (GPT-4o Medical Assistant)
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_DEPLOYMENT_NAME="gpt-4o"
AZURE_OPENAI_API_VERSION="2024-08-01-preview"

# 4. Microsoft Azure AI Content Safety (Clinical Red Flag Escalation)
AZURE_CONTENT_SAFETY_ENDPOINT=""
AZURE_CONTENT_SAFETY_KEY=""
